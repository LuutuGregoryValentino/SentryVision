# Flask runtime
FLASK_APP=run.py
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change-me

# Database
DATABASE_URL=sqlite:///sentry_vision.db

# Optional API protection
API_KEY=

# Email notifications
EMAIL_NOTIFICATION_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_DEFAULT_SENDER=
PUBLIC_BASE_URL=http://localhost:5000

# Dashboard device visibility
VISIBLE_DEVICE_NAMES=ESP32-CAM,Ultrasonic Sensor,Buzzer
DEFAULT_DEVICE_NAME=ESP32-CAM
